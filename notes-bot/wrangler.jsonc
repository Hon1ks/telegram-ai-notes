{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notes-bot-simple",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "NOTES_DB",
      "database_name": "notes-bot-db",
      "database_id": "0c8832d8-30e2-4101-bc7a-820e8b9d6e93"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
  // Глобальный rate limit (опционально):
  //   npx wrangler kv namespace create RATE_LIMIT
  //   добавить в kv_namespaces: { "binding": "RATE_LIMIT", "id": "<id>" }
  // Секреты добавлять через:
  //   npx wrangler secret put TELEGRAM_TOKEN
  //   npx wrangler secret put OPENROUTER_API_KEY
  //   npx wrangler secret put STT_API_KEY
}
